<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <Optimize>true</Optimize>
    <!-- Release Native AOT favors a smaller executable over maximum runtime speed. -->
    <OptimizationPreference Condition="'$(Configuration)' == 'Release'">Size</OptimizationPreference>
    <!-- The service does not need a portable/native PDB in the published directory. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <!-- Release logs currently record exception messages, not stack traces. -->
    <StackTraceSupport Condition="'$(Configuration)' == 'Release'">false</StackTraceSupport>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="scripts\Install-Service.ps1" />
    <None Remove="scripts\Uninstall-Service.ps1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="scripts\Install-Service.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="scripts\Uninstall-Service.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
